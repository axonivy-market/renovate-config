{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Keep dependencies on master (LE/DEV) and the LTS release/12.0 up-to-date",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "master",
    "release/12.0"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "disabled",
  "timezone": "Asia/Bangkok",
  "schedule": [
    "before 5am on monday"
  ],
  "automerge": true,
  "packageRules": [
    {
      "description": "No major or replacement upgrades on the LTS release branch",
      "matchBaseBranches": [
        "release/12.0"
      ],
      "matchUpdateTypes": [
        "major",
        "replacement"
      ],
      "enabled": false
    },
    {
      "description": "No PrimeFaces upgrades",
      "matchPackageNames": [
        "org.primefaces:primefaces",
        "org.primefaces.extensions:primefaces-extensions"
      ],
      "enabled": false
    }
  ]
}
