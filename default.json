{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Keep dependencies on all active branches up-to-date",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays"
  ],
  "baseBranchPatterns": [
    "master",
    "release/12.0",
    "release/14.0"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "description": "Disable major and replacement upgrades for release branches",
      "matchBaseBranches": [
        "release/12.0",
        "release/14.0"
      ],
      "matchUpdateTypes": [
        "major",
        "replacement"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "org.apache.maven.plugins:*",
        "org.junit.jupiter:*",
        "org.assertj:*",
        "com.axonivy.ivy.ci:*"
      ],
      "automerge": true
    }
  ]
}
